# DecisAI environment configuration
# Claude is optional. Leave empty or omit to use local Ollama + template fallback.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Primary local model used by the app.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_NUM_GPU=0
OLLAMA_TIMEOUT=90
OLLAMA_NUM_PREDICT=140
OLLAMA_NUM_CTX=1024
OLLAMA_KEEP_ALIVE=10m

# Set to 1 to disable Claude even when a key is configured.
DISABLE_CLAUDE=0
