# DecisAI local configuration
# Leave ANTHROPIC_API_KEY empty to use local Ollama + template fallback only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Primary local model
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_NUM_GPU=0
OLLAMA_TIMEOUT=90
OLLAMA_NUM_PREDICT=140
OLLAMA_NUM_CTX=1024
OLLAMA_KEEP_ALIVE=10m

# Set to 1 for fully local/no-Claude operation.
DISABLE_CLAUDE=0
